APP_NAME="ELIOR Natural Stones"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://eliornaturalstones.com

# Administrator Seeding Credentials (REQUIRED IN PRODUCTION)
# In production, seeders require a strong password (minimum 12 chars).
ADMIN_DEFAULT_NAME="ELIOR Administrator"
ADMIN_DEFAULT_EMAIL=admin@eliornaturalstones.com
ADMIN_DEFAULT_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration (MySQL 8+ Recommended for Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elior_production
DB_USERNAME=elior_db_user
DB_PASSWORD=

# Session Security
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Filesystem & Storage
FILESYSTEM_DISK=public
MEDIA_DISK=public

# Cache & Queues
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Security, Sanctum & CORS
SANCTUM_STATEFUL_DOMAINS=eliornaturalstones.com
CORS_ALLOWED_ORIGINS="https://eliornaturalstones.com"

# Search Console & SEO Verification
GOOGLE_SITE_VERIFICATION=

# Mail Configuration (Enquiry persistence is database-driven; mail is optional)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@eliornaturalstones.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite Frontend
VITE_APP_NAME="${APP_NAME}"
